APP_NAME=Laravel
APP_ENV=production
APP_KEY=
# IMPORTANT: Set APP_DEBUG=false in production — debug mode exposes stack traces, SQL queries, and environment variables in error responses.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mis_reports
DB_USERNAME=mis_user
# IMPORTANT: Use a strong, unique password. Never use an empty or default password in production.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# IMPORTANT: Enable session encryption in production to prevent session data from being read in plain text in the database.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use 'redis' in production for best analytics caching performance
CACHE_STORE=redis
# CACHE_PREFIX=
MIS_CACHE_TTL=900
ANALYTICS_CACHE_TTL=900

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# IMPORTANT: Change MAIL_MAILER from 'log' to a real transport (smtp, ses, etc.) in production.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_TOKEN_EXPIRATION=43200
